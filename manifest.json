
{
  "manifest_version": 3,
  "name": "Aria Productivity Pro",
  "version": "3.2.0",
  "description": "Ghi chú, Hẹn giờ và Chat AI Kép (Claude + ChatGPT cùng một cuộc trò chuyện).",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ]
}
